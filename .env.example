# Copy to .env and adjust. Read by football_api.infra.settings.Settings.
DATABASE_URL=postgresql+asyncpg://football:football@127.0.0.1:5432/football
# Where `just sync` clones the openfootball repositories.
SOURCES_DIR=.cache/sources
# Set to false to skip the Wikidata enrichment phase.
WIKIDATA_ENABLED=true
WIKIDATA_ENDPOINT=https://query.wikidata.org/sparql
